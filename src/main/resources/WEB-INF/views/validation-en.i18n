# validation-en.i18n

acme.validation.header.message                		= The text must have from 1 to 75 characters and must not be blank
acme.validation.text.message                  		= The text must have from 1 to 255 characters and must not be blank
acme.validation.ticker.message                		= The ticker must follow the pattern: 2 uppercase letters, 2 digits, a hyphen, and 5-10 alphanumeric characters and must not be blank
acme.validation.correctDates.message          		= The start moment must be before end moment
acme.validation.duplicated-ticker.message     		= The ticker is duplicated
acme.validation.numberOfTactics.message       		= Strategies cannot be published unless they have at least one tactic
acme.validation.numberOfMilestones.message    		= Campaigns cannot be published unless they have at least one milestone
acme.validation.numberOfAuditSections.message 		= Audit Reports cannot be published unless they have at least one audit section
acme.validation.numberOfParts.message         		= Inventions cannot be published unless they have at least one part
acme.validation.numberOfDonations.message     		= Sponsorships cannot be published unless they have at least one donation
acme.validation.currency.message              		= The currency must be in Euros
acme.validation.invention.future-interval.message 	= The dates should be in the future
acme.validation.future-interval.message 			= The dates should be in the future
acme.validation.numberOfInventions.message    		= Projects cannot be published unless they have at least one invention
acme.validation.duplicated-member 					= A project member cannot participate more than once with the same role in the same project
acme.validation.member-lacks-role					= The member does not have the selected role
acme.validation.unpublished-inventions.message = Projects cannot be published if their inventions aren't published
acme.validation.unpublished-strategies.message = Projects cannot be published if their strategies aren't published
acme.validation.unpublished-campaigns.message = Projects cannot be published if their campaigns aren't published
acme.validation.project-association.message = The project and this element must be published to associate
